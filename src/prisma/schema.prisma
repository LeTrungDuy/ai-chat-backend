model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id             String    @id @default(cuid())
  content        String
  role           Role
  conversationId String
  createdAt      DateTime  @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

enum Role {
  user
  assistant
}