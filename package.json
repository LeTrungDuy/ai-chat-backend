{
  "name": "ai-chat-backend",
  "version": "1.0.0",
  "description": "A simple AI Chat Backend using Node.js, Express, and MySQL with Prisma ORM.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build": "prisma generate",
    "migrate": "prisma migrate dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT"
}
